{
  "name": "parallel",
  "displayName": "Parallel",
  "description": "Live shared coding sessions with permission-based live editing",
  "version": "0.0.1",
  "publisher": "team-parallel",
  "repository": {
    "type": "git",
    "url": "https://github.com/samxshetty/hackloop-parallel"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "parallel.start",
        "title": "Parallel: Start Session"
      },
      {
        "command": "parallel.join",
        "title": "Parallel: Join Session"
      },
      {
        "command": "parallel.changeRole",
        "title": "Parallel: Change Role"
      },
      {
        "command": "parallel.requestEditAccess",
        "title": "Parallel: Request Edit Access"
      },
      {
        "command": "parallel.grantEditAccess",
        "title": "Parallel: Grant Edit Access"
      },
      {
        "command": "parallel.revokeEditAccess",
        "title": "Parallel: Revoke Edit Access"
      }
    ],
    "configuration": {
      "title": "Parallel",
      "properties": {
        "parallel.serverUrl": {
          "type": "string",
          "default": "ws://localhost:8080",
          "description": "Address of the Parallel server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
