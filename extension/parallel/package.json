{
  "name": "parallel",
  "displayName": "Parallel",
  "description": "Live shared coding sessions with permission-based live editing",
  "version": "0.0.1",
  "publisher": "team-parallel",
  "repository": {
    "type": "git",
    "url": "https://github.com/samxshetty/hackloop-parallel"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "parallel.start",
        "title": "Parallel: Start Session"
      },
      {
        "command": "parallel.join",
        "title": "Parallel: Join Session"
      },
      {
        "command": "parallel.changeRole",
        "title": "Parallel: Change Role"
      },
      {
        "command": "parallel.requestEditAccess",
        "title": "Parallel: Request Edit Access"
      },
      {
        "command": "parallel.grantEditAccess",
        "title": "Parallel: Grant Edit Access"
      },
      {
        "command": "parallel.revokeEditAccess",
        "title": "Parallel: Revoke Edit Access"
      },
      {
        "command": "parallel.commitWithCredit",
        "title": "Parallel: Commit With Credit"
      },
      {
        "command": "parallel.showSafetyLog",
        "title": "Parallel: Show Safety Log"
      },
      {
        "command": "parallel.openLastReplay",
        "title": "Parallel: Open Last Replay"
      },
      {
        "command": "parallel.openReplayFile",
        "title": "Parallel: Open Replay File"
      },
      {
        "command": "parallel.exportReplayHtml",
        "title": "Parallel: Export Replay as HTML"
      },
      {
        "command": "parallel.openAdminDashboard",
        "title": "Parallel: Open Admin Dashboard"
      },
      {
        "command": "parallel.openHackathonMode",
        "title": "Parallel: Open Hackathon Mode"
      },
      {
        "command": "parallel.micTest",
        "title": "Parallel: Test Microphone"
      },
      {
        "command": "parallel.jumpToPerson",
        "title": "Parallel: Jump to Person"
      },
      {
        "command": "parallel.shareTerminal",
        "title": "Parallel: Share Terminal"
      },
      {
        "command": "parallel.stopSharingTerminal",
        "title": "Parallel: Stop Sharing Terminal"
      },
      {
        "command": "parallel.toggleTerminalInput",
        "title": "Parallel: Allow or Block Typing in Shared Terminal"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parallel",
          "title": "Parallel",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "parallel": [
        {
          "id": "parallel.participants",
          "name": "Participants"
        }
      ]
    },
    "configuration": {
      "title": "Parallel",
      "properties": {
        "parallel.serverUrl": {
          "type": "string",
          "default": "ws://localhost:8080",
          "description": "Address of the Parallel server"
        },
        "parallel.terminalShell": {
          "type": "string",
          "default": "",
          "description": "Shell to run in the shared terminal (empty: cmd.exe on Windows, $SHELL elsewhere)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
